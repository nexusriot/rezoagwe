# editor / OS
.idea/
.vscode/
.DS_Store

# build output
build/
dist/
*.deb
# `make clean` names these, so a build can leave them in the repository root
/rezoagwe-bootstrap
/rezoagwe-discovery
/rezoagwectl
# what `go build ./cmd/...` drops here when it is run without -o
/bootstrap
/discovery
/ctl

# Go test artifacts
*.test
*.out
# `go test -cpuprofile/-memprofile` and `go tool cover -html` output
*.prof
*.pprof
coverage.html
# -logfile writes wherever it is pointed, and that is usually here
*.log

# runtime data / persistence
/data-dir*/
*.tmp
# Runtime journals and retained corruption evidence; keep exports/JSON fixtures visible.
*.wal
*.corrupt-*
*.profile-owner
*.migrated
# what `-snapshot-dir .` rotates in the working directory (rezoagwe-<stamp>.json)
rezoagwe-[0-9]*-[0-9]*.json

# Android
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
# Kotlin 2.x keeps its build session here
android/.kotlin/
android/captures/
android/app/release/
# signing keys never belong in the repository, debug or not
*.jks
*.keystore

# Electron
electron/node_modules/
electron/dist/
electron/shots/
# The repository-wide `build/` rule above also swallows electron/build, which is
# where packaging resources belong — so re-include the directory and ignore only
# what scripts/make-icon.mjs generates into it.
!electron/build/
electron/build/icon.png
electron/build/icons/
